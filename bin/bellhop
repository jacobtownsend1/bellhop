#!/usr/bin/env python3
"""Launch Bellhop from a checkout or installation."""

from pathlib import Path
import sys

root = Path(__file__).resolve().parent.parent
if (root / 'bellhop' / '__init__.py').is_file():
    sys.path.insert(0, str(root))
else:
    sys.path.insert(0, str(root / 'lib' / 'bellhop'))

from bellhop.__main__ import main

sys.exit(main())
